#!/bin/bash
# Shell jako defaultuser (uid 100000) v kontejneru; env pro GUI dodá /etc/profile.d/sfos.sh.
# arch-shell            -> login shell
# arch-shell cmd args   -> příkaz
if [[ $# == 0 ]]; then
	exec crun exec -t -e TERM="${TERM:-xterm-256color}" arch su - defaultuser
else
	exec crun exec -t -e TERM="${TERM:-xterm-256color}" arch su - defaultuser -c "$(printf '%q ' "$@")"
fi
